# ElevenLabs API key — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Anthropic API key — https://console.anthropic.com — used for title translation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vimeo — https://developer.vimeo.com/apps → generate token with upload + edit scopes
VIMEO_ACCESS_TOKEN=your_vimeo_access_token_here
# Optional: Vimeo folder/showcase ID (find it in the URL: vimeo.com/manage/folders/{id})
VIMEO_FOLDER_ID=

# OpenAI — https://platform.openai.com/api-keys
# Generates the per-video glass icon on the YouTube thumbnail (gpt-image-1).
# Without it thumbnails still render, using the built-in green shape.
OPENAI_API_KEY=your_openai_api_key_here

# Circle community — Developers → Tokens → Admin V2
CIRCLE_API_TOKEN=your_circle_api_token_here

# Slack app — https://api.slack.com/apps
# Required bot scopes: channels:history, chat:write, groups:history, files:read
# Also enable Interactivity with request URL https://<host>/slack/interactive
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# YouTube — run `python3 scripts/youtube_auth.py` once to generate these
# Google Cloud → YouTube Data API v3 → OAuth 2.0 credentials (Desktop app)
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token_from_auth_script
# Optional: default playlist for course videos
# Find the ID in the URL: youtube.com/playlist?list=PLxxxxxxxx
YOUTUBE_PLAYLIST_ID=
# Optional: per-course playlists, mapping Circle course space ID -> playlist ID.
# Falls back to YOUTUBE_PLAYLIST_ID when a course is not listed here.
# Standalone videos are never added to a playlist.
YOUTUBE_PLAYLIST_MAP={"2710272": "PLxxxxxxxx"}

# HeyGen credentials (kept for future phases)
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_VOICE_ID=your_heygen_voice_id_here

# Optional: clip appended to course videos (default: assets/outro.mp4)
# Standalone videos never get an outro.
OUTRO_PATH=assets/outro.mp4

# Output directory for downloaded videos (default: downloads)
DOWNLOAD_DIR=downloads

# Brand style registry — draws the thumbnail so this app does not decide what
# wxrks looks like. Mint a token at styles.agents.wxrks.app/tokens.
# Unset, the local PIL renderer in src/thumbnail.py is used instead, which
# still works but drifts from the brand the moment the palette changes.
STYLE_REGISTRY_URL=https://styles.agents.wxrks.app
STYLE_REGISTRY_TOKEN=
# Which registered thumbnail style to render (default: youtube-deck).
# youtube-series is Rodolfo's guide-playlist template.
THUMBNAIL_STYLE=youtube-deck
